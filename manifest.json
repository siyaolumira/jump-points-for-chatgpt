{
  "manifest_version": 3,
  "name": "Jump Points for ChatGPT",
  "version": "0.12.3",
  "description": "Place three movable points in long ChatGPT conversations and jump between them instantly.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
